@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <h4>🚀 OnPremCompose</h4>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<style>
    .page {
        display: flex;
        height: 100vh;
    }

    .sidebar {
        width: 250px;
        background-color: #f8f9fa;
        border-right: 1px solid #dee2e6;
        padding: 1rem;
    }

    main {
        flex: 1;
        overflow-y: auto;
    }

    .top-row {
        background-color: #fff;
        border-bottom: 1px solid #dee2e6;
        height: 60px;
        display: flex;
        align-items: center;
    }

    .content {
        padding: 1rem;
    }
</style>
